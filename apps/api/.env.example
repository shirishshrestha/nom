PORT=3000

DATABASE_URL=postgres://nom:nom@localhost:5432/nom

DB_TEST_HOST=localhost
DB_TEST_PORT=5432
DB_TEST_USERNAME=nom
DB_TEST_PASSWORD=nom
DB_TEST_NAME=nom_test

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Run transaction line-item matching on the BullMQ worker instead of inline on the
# request. Defaults to sync (unset/false). Requires Redis.
# TRANSACTION_MATCH_ASYNC=false
# Backstop timeout (ms) for a background match job; on timeout the doc reverts to
# committed rather than sitting on `matching` forever. Defaults to 300000 (5 min).
# MATCH_JOB_TIMEOUT_MS=300000

# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8000
WEB_URL=http://localhost:5173

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# LLM agents (LangGraph). Models default to gemini-2.0-flash / claude-haiku-4-5.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# GEMINI_MODEL=gemini-2.0-flash
# Per-call bounds on the adjudicator (matching/reasoning) model so a stalled request
# rejects instead of hanging. Defaults: 120000 ms timeout, 2 SDK retries.
# ANTHROPIC_TIMEOUT_MS=120000
# ANTHROPIC_MAX_RETRIES=2
